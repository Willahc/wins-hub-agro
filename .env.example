# Copie para .env e preencha. NÃO comite o .env (já está no .gitignore).
# OBS (compose v2): valores com `$` (ex.: hash bcrypt) precisam escapar `$` como `$$`.

# --- Banco de dados ---
POSTGRES_DB=wins_agro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=          # defina uma senha forte
DB_HOST=db
DB_PORT=5432
# DB_USER / DB_PASSWORD são opcionais — se ausentes, caem para POSTGRES_USER/POSTGRES_PASSWORD.

# --- App ---
# gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Fail-safe: a app NÃO sobe se SECRET_KEY ficar com o valor padrão.
SECRET_KEY=

# --- Login (usuária única) ---
MARI_EMAIL=mari@exemplo.com
# hash bcrypt da senha. gere com:
# python -c "import bcrypt; print(bcrypt.hashpw(b'SUA_SENHA', bcrypt.gensalt()).decode())"
# No .env (compose v2) escape os '$' do hash como '$$'.
MARI_PASSWORD_HASH=

# --- MFA (TOTP) — obrigatório p/ o 2º fator ---
# segredo base32 compartilhado; gere com:
# python -c "import pyotp; print(pyotp.random_base32())"
MFA_TOTP_SECRET=

# --- Login por digital (WebAuthn/passkey) — não são segredos, mas precisam casar com o domínio ---
WEBAUTHN_RP_ID=winshubagro.cloud
WEBAUTHN_ORIGIN=https://winshubagro.cloud

# --- Enriquecimento (scripts opcionais; só se for rodar harvesters) ---
SERPER_API_KEY=            # busca Google (serper.dev) — usado pelos scripts de enrich/social
# APIFY_TOKEN=             # opcional, scrapers Apify
