DB_HOST=db
DB_PORT=5432

# --- App ---
# gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Login (usuária única) ---
MARI_EMAIL=mari@exemplo.com
# hash bcrypt da senha. gere com:
# python -c "import bcrypt; print(bcrypt.hashpw(b'SUA_SENHA', bcrypt.gensalt()).decode())"
MARI_PASSWORD_HASH=
