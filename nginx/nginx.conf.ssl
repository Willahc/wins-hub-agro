# Rate-limit do login (anti força-bruta): ~10 tentativas/min por IP, com folga de burst.
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
# API geral: protege contra scraping/abuso com cookie vazado sem atrapalhar o uso real
# (sync do outbox é sequencial; folga grande de burst p/ telas que fazem fan-out).
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
# Simulador público gera PDF (WeasyPrint ~150ms de CPU): sem limite é DoS barato.
limit_req_zone $binary_remote_addr zone=simulador:10m rate=10r/m;
# Export CSV de PII (200k linhas): raro e pesado — 2/min já é folga p/ uso legítimo.
limit_req_zone $binary_remote_addr zone=csvexp:10m rate=2r/m;

server {
    listen 80;
    listen [::]:80;
    server_name winshubagro.cloud www.winshubagro.cloud;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name winshubagro.cloud www.winshubagro.cloud;

    ssl_certificate /etc/letsencrypt/live/winshubagro.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/winshubagro.cloud/privkey.pem;

    # limite de upload coerente com o cap da app (OCR do brinco). Default do nginx é 1MB.
    client_max_body_size 12m;

    # TLS: só 1.2/1.3
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Compressão (HTML, JSON, JS, CSS, manifest)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript
               text/javascript application/manifest+json image/svg+xml;

    # Headers de segurança (always = inclui respostas de erro como o 401 da API).
    # Libs agora são self-hosted -> CSP apertada para 'self' (sem CDNs externos).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org; connect-src 'self'; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    # Login com rate-limit (burst tolera recarga humana; bloqueia brute-force).
    location = /login {
        limit_req zone=login burst=8 nodelay;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # PDF público do simulador: rate apertado (CPU-bound no WeasyPrint)
    location = /api/simulador/proposta {
        limit_req zone=simulador burst=5 nodelay;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Export CSV de PII: raro por natureza; barra dump em loop com cookie vazado
    location = /api/leads/csv {
        limit_req zone=csvexp burst=3 nodelay;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
